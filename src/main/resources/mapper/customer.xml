<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mall.mapper.CustomerMapper">
    <insert id="save">
        INSERT INTO customers(customer_id, password, name, email, address, join_date)
        VALUES (#{cust.customerId}, #{cust.password}, #{cust.name},
        #{cust.email}, #{cust.address}, #{cust.joinDate});
    </insert>

    <select id="getCustomers">
        SELECT * from customers;
    </select>

    <select id="getCustomerById" parameterType="int" resultType="com.example.mall.dto.CustomerDto">
        SELECT * from customers where customer_id = #{customerId};
    </select>
</mapper>
